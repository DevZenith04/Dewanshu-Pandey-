# Optional Groq API key for AI-generated recommendations from /api/recommend.
# Leave blank to keep the endpoint disabled; ML risk prediction does not require it.
GROQ_API_KEY=

# Optional path for the hackathon SQLite assessment store.
# Defaults to ./zameen.db when omitted.
ZAMEEN_DB_PATH=./zameen.db

# Comma-separated exact browser origins allowed to call the API.
FRONTEND_ORIGINS=http://127.0.0.1:8123,http://localhost:8123
